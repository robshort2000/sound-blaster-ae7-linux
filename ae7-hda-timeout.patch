+	 * Sound Blaster AE-7: CORB reset MMIO never completes on this
+	 * controller. Waiting for CORBRP.RST with IRQs off hard-locks
+	 * the machine (kernel bug 217510). Skip the wait and use PIO.
+	 */
+	{ PCI_DEVICE_SUB(PCI_VENDOR_ID_CREATIVE, 0x0010,
+			 PCI_VENDOR_ID_CREATIVE, 0x0081),
+	  .driver_data = AZX_DRIVER_CTHDA | AZX_DCAPS_PRESET_CTHDA |
+			 AZX_DCAPS_NO_TCSEL | AZX_DCAPS_PIO_COMMANDS },
 	{ PCI_VDEVICE(CREATIVE, 0x0010),
