 	gcap = azx_readw(chip, GCAP);
 	dev_dbg(card->dev, "chipset global capabilities = 0x%x\n", gcap);
+	/*
+	 * 0xffff means the BAR is not responding (D3cold or dead MMIO).
+	 * Interpreting it as GCAP invents 15+15 streams and a 0xffff
+	 * codec mask, which is what hard-locked the AE-7 (bug 217510).
+	 */
+	if (gcap == 0xffff) {
+		dev_err(card->dev,
+			"GCAP MMIO dead (0xffff); controller inaccessible, aborting probe\n");
+		return -EIO;
+	}
 
 	/* AMD devices support 40 or 48bit DMA, take the safe one */
 	if (chip->pci->vendor == PCI_VENDOR_ID_AMD)
@@ -2046,17 +2056,21 @@ static int azx_first_init(struct azx *chip)
 	err = hda_init_streams(chip);
