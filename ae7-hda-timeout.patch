 		return err;
+	dev_info(card->dev, "AE7dbg GCAP after streams %#x\n", azx_readw(chip, GCAP));
 
 	err = azx_alloc_stream_pages(chip);
 	if (err < 0)
 		return err;
+	dev_info(card->dev, "AE7dbg GCAP after pages %#x\n", azx_readw(chip, GCAP));
 
 	/* initialize chip */
 	azx_init_pci(chip);
+	dev_info(card->dev, "AE7dbg GCAP after azx_init_pci %#x\n", azx_readw(chip, GCAP));
 
 	snd_hdac_i915_set_bclk(bus);
 
 	hda_intel_init_chip(chip, (probe_only[dev] & 2) == 0);
+	dev_info(card->dev, "AE7dbg GCAP after init_chip %#x\n", azx_readw(chip, GCAP));
 
 	/* codec detection */
 	if (!azx_bus(chip)->codec_mask) {
@@ -2777,6 +2791,15 @@ static const struct pci_device_id azx_ids[] = {
 	  .driver_data = AZX_DRIVER_TERA | AZX_DCAPS_NO_64BIT },
