+/*
+ * Firmware restarts CORB/RIRB DMA against a bogus address after the PIO
+ * init has cleared it. The faults run for a long time and, when they
+ * stop, analog goes silent while PCM keeps playing. Clear the run bits
+ * only. Never write the CORB/RIRB base registers.
+ */
+static void ae7_corb_work(struct work_struct *work)
+{
+	struct ca0132_spec *spec = container_of(to_delayed_work(work),
+			struct ca0132_spec, ae7_corb_work);
+	struct hda_codec *codec = spec->codec;
+	struct hdac_bus *bus = codec->core.bus;
+	u16 gcap;
+	u8 corb, rirb;
+
+	if (ae7_cmd_dead || ca0132_quirk(spec) != QUIRK_AE7)
+		return;
+	if (!bus || !bus->remap_addr)
+		return;
+
+	gcap = readw(bus->remap_addr);
+	if (gcap == 0xffff) {
+		ae7_cmd_dead = true;
+		codec_err(codec, "AE-7 MMIO dead in CORB watchdog\n");
+		return;
+	}
+
+	corb = readb(bus->remap_addr + 0x4c);
+	rirb = readb(bus->remap_addr + 0x5c);
+	if ((corb & 0x02) || (rirb & 0x02)) {
+		writeb(0, bus->remap_addr + 0x4c);
+		writeb(0, bus->remap_addr + 0x5c);
+		gcap = readw(bus->remap_addr);
+		if (gcap == 0xffff) {
+			ae7_cmd_dead = true;
+			codec_err(codec, "AE-7 died stopping leftover CORB\n");
+			return;
+		}
+		if (!spec->ae7_corb_noted) {
+			spec->ae7_corb_noted = true;
+			codec_info(codec,
+				   "AE-7 stopped restarted CORBCTL=%#x RIRBCTL=%#x\n",
+				   corb, rirb);
+		}
+	}
+
+	schedule_delayed_work(&spec->ae7_corb_work, msecs_to_jiffies(2000));
+}
