+static bool ae7_gcap_ok(struct hda_codec *codec, const char *stage)
+{
+	struct hdac_bus *bus = codec->core.bus;
+	u16 gcap = 0xffff;
+	u32 id = 0xffffffff;
+
+	if (bus && bus->remap_addr)
+		gcap = readw(bus->remap_addr);
+	/*
+	 * GCAP 0xffff means the BAR is already not responding. A PCI config
+	 * read of a function that has fallen off the bus is the access that
+	 * sits in an uninterruptible completion wait and locks the machine.
+	 * Do not touch config space once MMIO is dead.
+	 */
+	if (gcap == 0xffff) {
+		ae7_cmd_dead = true;
+		codec_err(codec, "AE-7 died at %s (MMIO)\n", stage);
+		return false;
+	}
+	if (codec->bus && codec->bus->pci)
+		pci_read_config_dword(codec->bus->pci, PCI_VENDOR_ID, &id);
+	codec_info(codec, "AE7dbg %s: GCAP=%#x pci=%#x\n", stage, gcap, id);
+	if (id == 0xffffffff) {
+		codec_err(codec, "AE-7 died at %s\n", stage);
+		ae7_cmd_dead = true;
+		return false;
+	}
+	return true;
+}
